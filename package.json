{
  "name": "pdf2png",
  "version": "0.1.2",
  "private": true,
  "description": "Web editor for CUBE-style traffic-modeling PDF road networks",
  "author": "pdf2png contributors",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "dev:electron": "concurrently -k -n NEXT,ELECTRON -c blue,magenta \"next dev -p 3000\" \"wait-on http://127.0.0.1:3000 && electron dist-electron/main.js\"",
    "build:next": "next build",
    "build:next:stage": "npm run build:next && node scripts/copy-pdf-worker.mjs && node scripts/copy-standalone-assets.mjs",
    "build:electron": "npm run electron:compile",
    "build:win": "npm run build:next:stage && npm run build:electron && electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64",
    "pin:sharp:win": "node scripts/pin-sharp-windows.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "26.0.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "2.1.8",
    "wait-on": "^8.0.0"
  }
}
